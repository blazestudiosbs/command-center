# Existing Command Center integrations
# Leave OPENAI_API_KEY blank to keep cloud requests disabled and use local behavior.
# Add the key only in your private .env file; never commit a real token.
OPENAI_API_KEY=
# This model is used only when OPENAI_API_KEY is configured.
OPENAI_MODEL=gpt-4.1-mini
VERA_LOCAL_MODEL=qwen3:4b-instruct
VERA_LOCAL_MAX_OUTPUT_TOKENS=512

# Vera budget simulation (USD). Simulation never makes an OpenAI request.
VERA_BUDGET_MONTHLY_USD=5.00
VERA_BUDGET_DAILY_USD=0.50
VERA_BUDGET_PER_REQUEST_USD=0.10
# GPT-4.1 mini standard pricing defaults; override when pricing changes.
VERA_OPENAI_INPUT_COST_PER_MILLION=0.40
VERA_OPENAI_OUTPUT_COST_PER_MILLION=1.60

# Local-first routing simulation. Values are between 0 and 1.
VERA_ROUTER_LOCAL_CONFIDENCE_THRESHOLD=0.70

# Read-only Home Assistant connection. Create a long-lived access token in Home Assistant.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

DISCORD_WEBHOOK=
MINECRAFT_RCON_HOST=
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=

# Vera owner authentication
VERA_ADMIN_USERNAME=bruce
VERA_ADMIN_PASSWORD_HASH=
VERA_DATABASE_PATH=/app/config/vera.db

# Keep false for the current HTTP-only LAN/Tailscale deployment.
# Change to true when Command Center is served over HTTPS.
VERA_COOKIE_SECURE=false
